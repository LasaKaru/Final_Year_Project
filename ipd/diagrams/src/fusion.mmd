    GATE -->|yes| PARSE{"parsed, grounded,<br/>confidence ≥ τ = 0.80?"}
    PARSE -->|no| KEEP1["final = symbolic"]
    PARSE -->|"yes and symbolic = Vulnerable,<br/>model = Protected"| SUP["final = Protected<br/>(suppressed false positive)"]
    PARSE -->|"any other combination"| KEEP2["final = symbolic<br/>(no escalation, ADR-012)"]
