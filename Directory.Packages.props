<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Roslyn: all Microsoft.CodeAnalysis.* MUST share one version -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <!-- Local inference (CPU build). Swap for .DirectML (Windows GPU) or .Cuda later -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.20.0" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.34" />
    <!-- Test-only references so in-memory compilations can resolve EF Core types -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.34" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.34" />
  </ItemGroup>
</Project>
